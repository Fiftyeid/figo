{
  "name": "jalibib-motion",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "assets": "node scripts/copy-assets.mjs",
    "predev": "npm run assets",
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc -b --pretty false",
    "prebuild": "npm run assets",
    "build": "tsc -b && vite build",
    "studio": "remotion studio src/register.tsx",
    "render": "remotion render src/register.tsx Jalibib out/jalibib-remotion.mp4"
  },
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "@remotion/player": "4.0.539",
    "@remotion/web-renderer": "4.0.539",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "5.1.0",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "7.1.12"
  }
}
